# /etc/edu-agent-server/broker.env（root:root 0600）。令牌不写在这里，见 edu-agent-broker.service 的 LoadCredential。
EDU_BROKER_IMAGE=edu-agent-jiuwen-client:<客户端提交>
EDU_BROKER_COURSE_CONTAINER=edu-agent-jiuwen-course-1
EDU_BROKER_ORIGIN_HOSTS=agent.hrtiger.cn,127.0.0.1,localhost
# 不用 Docker 默认地址池（智教云的学习网络也从那里分），11-05 查过与主机现有网络、路由不重叠。
EDU_BROKER_SUBNETS=10.231.0.0/16
# 与 server.env 的 EDU_WORKSPACE_PORTS 一致；11-05 查过这一段在主机上没有监听。
EDU_WORKSPACE_PORTS=57000-57999
EDU_BROKER_MEMORY_MB=4096
EDU_BROKER_CPUS=2
EDU_BROKER_PIDS=512
