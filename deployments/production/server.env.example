EDU_ENV=production
EDU_LISTEN=127.0.0.1:4020
EDU_METRICS_LISTEN=127.0.0.1:4029
EDU_WEB_ORIGINS=https://agent.hrtiger.cn
EDU_TRUST_PROXY=loopback
EDU_ALLOW_LOOPBACK_ORIGINS=true
DATABASE_URL=postgres://edu_agent:<application-password>@127.0.0.1:25432/edu_agent?sslmode=disable
# 每人一个 WorkSwarm 容器（P2）。不设 EDU_WORKSPACE_BROKER 时 POST /v1/workspace 返回 503。
EDU_WORKSPACE_BROKER=/run/edu-agent-broker/broker.sock
EDU_INTERNAL_LISTEN=127.0.0.1:4021
EDU_WORKSPACE_PORTS=57000-57999
# 内测给保守值；正式投入使用另配服务器后再放开。
EDU_WORKSPACE_LIMIT=16
EDU_WORKSPACE_IDLE=30m
# EDU_COOKIE_DOMAIN and EDU_MIN_CLIENT_VERSION are intentionally unset.
