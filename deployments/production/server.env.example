EDU_ENV=production
EDU_LISTEN=127.0.0.1:4020
EDU_METRICS_LISTEN=127.0.0.1:4029
EDU_WEB_ORIGINS=https://agent.hrtiger.cn
EDU_TRUST_PROXY=loopback
EDU_ALLOW_LOOPBACK_ORIGINS=true
DATABASE_URL=postgres://edu_agent:<application-password>@127.0.0.1:25432/edu_agent?sslmode=disable
# 每人一个 WorkSwarm 容器（P2）。不设 EDU_WORKSPACE_BROKER 时 POST /v1/workspace 返回 503。
EDU_WORKSPACE_BROKER=/run/edu-agent-broker/broker.sock
EDU_INTERNAL_LISTEN=127.0.0.1:4021
EDU_WORKSPACE_PORTS=57000-57999
# 内测给保守值；正式投入使用另配服务器后再放开。
EDU_WORKSPACE_LIMIT=16
EDU_WORKSPACE_IDLE=30m
# EDU_COOKIE_DOMAIN and EDU_MIN_CLIENT_VERSION are intentionally unset.

# AI 漫剧（docs/comic-studio.md）。不设 EDU_COMIC_MEDIA_DIR 则 /v1/comic 全部返回 503。
# 主机要装 ffmpeg/ffprobe（含 libx264、libmp3lame）；烧录字幕要中文字体文件。
EDU_COMIC_MEDIA_DIR=/var/lib/edu-agent-server/comic
# 新账号第一次打开漫剧时送的创作点（1 点约 0.1 元模型成本）。
EDU_COMIC_INITIAL_CREDITS=300
# 密钥只放文件（0640 root:edu-agent），这里写路径。没配的模型在界面上显示为不可用。
EDU_COMIC_MINIMAX_KEY_FILE=/etc/edu-agent-server/minimax.key
EDU_COMIC_ARK_KEY_FILE=/etc/edu-agent-server/ark.key
EDU_COMIC_TEXT_KEY_FILE=/etc/edu-agent-server/deepseek.key
# EDU_COMIC_MINIMAX_BASE=https://api.minimax.cn
# EDU_COMIC_ARK_BASE=https://ark.cn-beijing.volces.com
# EDU_COMIC_TEXT_BASE=https://api.deepseek.com
# EDU_COMIC_TEXT_MODEL=deepseek-chat
# EDU_COMIC_SUBTITLE_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# 演示环境可打开模拟模型（不扣点、标「模拟」）：EDU_COMIC_SIMULATE=1
